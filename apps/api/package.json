{
  "name": "@sop-agent/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/start.ts",
    "start": "tsx --env-file-if-exists=../../.env src/start.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file-if-exists=../../.env src/smoke/liveSmokeTest.ts",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:recheck": "tsx src/evals/recheckRun.ts",
    "fixtures": "tsx src/testing/writeDocumentFixtures.ts",
    "measure:extraction": "tsx --env-file-if-exists=../../.env src/smoke/measureExtraction.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@sop-agent/sop-core": "workspace:*",
    "fastify": "^5.12.5",
    "mammoth": "^1.12.3",
    "node-html-parser": "^9.0.4",
    "openai": "^7.19.0",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "docx": "^9.7.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
