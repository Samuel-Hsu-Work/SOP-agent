{
  "name": "sop-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "spike:generate-fixtures": "pnpm --filter @sop-agent/extraction-spike generate-fixtures",
    "spike:extraction": "pnpm --filter @sop-agent/extraction-spike start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
