# Copy this file to .env and fill in the key. .env is git-ignored.
OPENAI_API_KEY=

# Optional. These are the defaults. The fallback model runs only when the primary fails or refuses.
LLM_MODEL=gpt-5.6-sol
LLM_FALLBACK_MODEL=gpt-5.6-luna

# Optional. API server settings, and the origin the browser app is served from (for CORS).
API_HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
